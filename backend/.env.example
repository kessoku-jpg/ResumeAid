# Copy to backend/.env and fill in. Never commit the real .env.

# Adzuna API (optional — free key at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGINS=*

# Server bind address. Use 0.0.0.0 only behind a production server.
HOST=127.0.0.1
PORT=5000

# Set to 1 for local development only
FLASK_DEBUG=0
